#!/usr/bin/env bash
set -euo pipefail

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
repo_root="$(cd "$script_dir/.." && pwd)"
dev_root="${SVAROG_DEV_ROOT:-$repo_root/.svarog-dev}"
target_dir="${CARGO_TARGET_DIR:-$repo_root/target}"
dev_binary="$target_dir/release/svarog"
state_file="$dev_root/.source-fingerprint"

explicit_update=false
build_only=false
case "${1:-}" in
  --update)
    explicit_update=true
    shift
    ;;
  --build-only)
    explicit_update=true
    build_only=true
    shift
    if [[ "$#" -ne 0 ]]; then
      echo "--build-only does not accept Svarog arguments" >&2
      exit 2
    fi
    ;;
esac

for command_name in cksum find sort; do
  if ! command -v "$command_name" >/dev/null 2>&1; then
    echo "Missing required command: $command_name" >&2
    exit 1
  fi
done

source_fingerprint="$({
  for file in "$repo_root/Cargo.toml" "$repo_root/Cargo.lock" "$repo_root/build.rs"; do
    if [[ -f "$file" ]]; then
      cksum "$file"
    fi
  done
  for directory in "$repo_root/src" "$repo_root/prompts" "$repo_root/data"; do
    if [[ -d "$directory" ]]; then
      find "$directory" -type f -print | LC_ALL=C sort | while IFS= read -r file; do
        cksum "$file"
      done
    fi
  done
} | cksum | awk '{print $1 ":" $2}')"

stored_fingerprint=""
if [[ -f "$state_file" ]]; then
  stored_fingerprint="$(sed -n '1p' "$state_file")"
fi

build_checkout() {
  if ! command -v rustc >/dev/null 2>&1 || ! command -v cargo >/dev/null 2>&1; then
    "$script_dir/bootstrap"
  fi
  echo "Building the changed local Svarog checkout..."
  cargo build --release --locked --manifest-path "$repo_root/Cargo.toml"
  if [[ ! -x "$dev_binary" ]]; then
    echo "Cargo reported success but did not build $dev_binary" >&2
    exit 1
  fi
  mkdir -p "$dev_root"
  state_tmp="$state_file.tmp.$$"
  printf '%s\n' "$source_fingerprint" >"$state_tmp"
  mv "$state_tmp" "$state_file"
}

needs_build=false
if [[ ! -x "$dev_binary" || "$stored_fingerprint" != "$source_fingerprint" ]]; then
  needs_build=true
fi

if [[ "$needs_build" == true ]]; then
  update_policy="${SVAROG_UPDATE:-ask}"
  if [[ "$explicit_update" == true || ! -x "$dev_binary" ]]; then
    update_policy=always
  fi
  case "$update_policy" in
    always) build_checkout ;;
    never) ;;
    ask)
      if [[ -t 0 && -t 2 ]]; then
        read -r -p "Local Svarog source has changed. Rebuild it before continuing? [Y/n] " answer
        case "$answer" in
          n|N|no|NO) ;;
          *) build_checkout ;;
        esac
      else
        build_checkout
      fi
      ;;
    *)
      echo "SVAROG_UPDATE must be one of: ask, always, never" >&2
      exit 2
      ;;
  esac
fi

if [[ ! -x "$dev_binary" ]]; then
  echo "No development Svarog binary is available to run." >&2
  exit 1
fi

if [[ "$build_only" == true ]]; then
  exit 0
fi

export SVAROG_MODE=dev
export SVAROG_HOME="$dev_root/svarog"
export CODEX_HOME="$dev_root/codex"
export SVAROG_DAEMON_ADDR="${SVAROG_DAEMON_ADDR:-127.0.0.1:18787}"
export SVAROG_DEV_LAUNCHER="$script_dir/svarog"

exec "$dev_binary" "$@"
