#!/usr/bin/env bash
set -euo pipefail

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
repo_root="$(cd "$script_dir/.." && pwd)"

missing_prerequisite=false
for command_name in rustc cargo tmux; do
  if ! command -v "$command_name" >/dev/null 2>&1; then
    missing_prerequisite=true
  fi
done
if [[ "$missing_prerequisite" == true ]]; then
  "$script_dir/bootstrap"
  if [[ -f "$HOME/.cargo/env" ]]; then
    # shellcheck disable=SC1091
    source "$HOME/.cargo/env"
  fi
fi

for command_name in rustc cargo tmux cksum find sort; do
  if ! command -v "$command_name" >/dev/null 2>&1; then
    echo "Missing required command after bootstrap: $command_name" >&2
    exit 1
  fi
done

source_fingerprint="$({
  for file in "$repo_root/Cargo.toml" "$repo_root/Cargo.lock" "$repo_root/build.rs"; do
    if [[ -f "$file" ]]; then
      cksum "$file"
    fi
  done
  for directory in "$repo_root/src" "$repo_root/prompts"; do
    if [[ -d "$directory" ]]; then
      find "$directory" -type f -print | LC_ALL=C sort | while IFS= read -r file; do
        cksum "$file"
      done
    fi
  done
} | cksum | awk '{print $1 ":" $2}')"

cargo_home="${CARGO_HOME:-$HOME/.cargo}"
installed_binary="$cargo_home/bin/svarog"
state_file="$cargo_home/.svarog-install-state"
existing_binary="$(command -v svarog 2>/dev/null || true)"
selected_binary="$installed_binary"

installed_matches=false
if [[ -x "$installed_binary" && -f "$state_file" ]]; then
  stored_root="$(sed -n '1p' "$state_file")"
  stored_fingerprint="$(sed -n '2p' "$state_file")"
  if [[ "$stored_root" == "$repo_root" && "$stored_fingerprint" == "$source_fingerprint" ]]; then
    installed_matches=true
  fi
fi

install_current_checkout() {
  cargo install --locked --path "$repo_root" --force
  if [[ ! -x "$installed_binary" ]]; then
    echo "Cargo reported success but did not install $installed_binary" >&2
    exit 1
  fi
  mkdir -p "$cargo_home"
  state_tmp="$state_file.tmp.$$"
  printf '%s\n%s\n' "$repo_root" "$source_fingerprint" >"$state_tmp"
  mv "$state_tmp" "$state_file"
  selected_binary="$installed_binary"
}

if [[ ! -x "$installed_binary" && -z "$existing_binary" ]]; then
  echo "Svarog is not installed; installing the current checkout."
  install_current_checkout
elif [[ "$installed_matches" != true ]]; then
  update_policy="${SVAROG_UPDATE:-ask}"
  case "$update_policy" in
    always) update=true ;;
    never) update=false ;;
    ask)
      if [[ -t 0 ]]; then
        current_version="$("${existing_binary:-$installed_binary}" --version 2>/dev/null || echo "unknown version")"
        echo "A newer local Svarog build is available ($current_version installed)."
        read -r -p "Install it now? [Y/n] " answer
        case "$answer" in
          n|N|no|NO) update=false ;;
          *) update=true ;;
        esac
      else
        update=true
      fi
      ;;
    *)
      echo "SVAROG_UPDATE must be one of: ask, always, never" >&2
      exit 2
      ;;
  esac

  if [[ "$update" == true ]]; then
    install_current_checkout
  elif [[ -n "$existing_binary" ]]; then
    selected_binary="$existing_binary"
  elif [[ -x "$installed_binary" ]]; then
    selected_binary="$installed_binary"
  else
    echo "No existing Svarog binary is available to run." >&2
    exit 1
  fi
fi

export SVAROG_SKIP_SELF_UPDATE=1
exec "$selected_binary" "$@"
