#!/usr/bin/env bash
set -euo pipefail

missing=()

if ! command -v rustc >/dev/null 2>&1; then
  missing+=("rust")
fi

if ! command -v cargo >/dev/null 2>&1; then
  if [[ ! " ${missing[*]} " =~ " rust " ]]; then
    missing+=("rust")
  fi
fi

if [[ ${#missing[@]} -eq 0 ]]; then
  echo "Svarog prerequisites are installed."
  rustc --version
  cargo --version
  exit 0
fi

echo "Missing prerequisites: ${missing[*]}"
echo
echo "Rust is required only when building Svarog from a source checkout."
echo "To use Svarog without Rust, install the verified prebuilt release:"
echo "  https://github.com/zotttttttt/svarog#install-with-the-release-installer"
echo
if command -v rustup >/dev/null 2>&1; then
  echo "rustup is installed but no usable Rust toolchain was found."
  echo "Configure a stable toolchain, then rerun scripts/bootstrap."
else
  echo "To build this checkout, install a stable Rust toolchain from:"
  echo "  https://rustup.rs"
  echo "Then rerun scripts/bootstrap."
fi
exit 1
