#!/usr/bin/env bash
set -euo pipefail

readonly embedded_version="@SVAROG_VERSION@"
readonly version="$embedded_version"
readonly template_version_marker="@""SVAROG_VERSION@"
readonly repository="https://github.com/zotttttttt/svarog"

if [[ "$version" == "$template_version_marker" ]]; then
  echo "This installer template must be generated by the Svarog release workflow." >&2
  exit 2
fi

for command_name in awk curl gzip install mkdir mktemp mv rm tar uname; do
  if ! command -v "$command_name" >/dev/null 2>&1; then
    echo "Missing required command: $command_name" >&2
    exit 1
  fi
done

os="$(uname -s)"
arch="$(uname -m)"
case "$os:$arch" in
  Darwin:arm64 | Darwin:aarch64)
    target="aarch64-apple-darwin"
    checksum_command="shasum"
    expected_checksum="@SVAROG_SHA256_AARCH64_APPLE_DARWIN@"
    ;;
  Darwin:x86_64)
    target="x86_64-apple-darwin"
    checksum_command="shasum"
    expected_checksum="@SVAROG_SHA256_X86_64_APPLE_DARWIN@"
    ;;
  Linux:x86_64 | Linux:amd64)
    target="x86_64-unknown-linux-gnu"
    checksum_command="sha256sum"
    expected_checksum="@SVAROG_SHA256_X86_64_UNKNOWN_LINUX_GNU@"
    ;;
  *)
    echo "Svarog does not provide a release binary for $os $arch." >&2
    echo "Supported targets: Apple Silicon macOS, Intel macOS, and x86-64 Linux." >&2
    exit 1
    ;;
esac

if [[ ! "$expected_checksum" =~ ^[0-9a-f]{64}$ ]]; then
  echo "The installer does not contain a valid embedded checksum for $target." >&2
  exit 2
fi

if ! command -v "$checksum_command" >/dev/null 2>&1; then
  echo "Missing required checksum command: $checksum_command" >&2
  exit 1
fi

archive="svarog-${version}-${target}.tar.gz"
package="svarog-${version}-${target}"
release_base_url="${SVAROG_RELEASE_BASE_URL:-$repository/releases/download/v$version}"
install_dir="${SVAROG_INSTALL_DIR:-${HOME:?HOME must be set}/.local/bin}"

if [[ "$install_dir" != /* ]]; then
  echo "SVAROG_INSTALL_DIR must be an absolute path: $install_dir" >&2
  exit 2
fi

work_dir="$(mktemp -d "${TMPDIR:-/tmp}/svarog-install.XXXXXX")"
install_temp=""
cleanup() {
  rm -rf "$work_dir"
  if [[ -n "$install_temp" ]]; then
    rm -f "$install_temp"
  fi
}
trap cleanup EXIT

echo "Downloading Svarog $version for $target..."
curl --proto '=https' --tlsv1.2 --fail --location --silent --show-error \
  --output "$work_dir/$archive" "$release_base_url/$archive"

if [[ "$checksum_command" == "shasum" ]]; then
  actual_checksum="$(shasum -a 256 "$work_dir/$archive" | awk '{ print $1 }')"
else
  actual_checksum="$(sha256sum "$work_dir/$archive" | awk '{ print $1 }')"
fi
if [[ "$actual_checksum" != "$expected_checksum" ]]; then
  echo "Checksum verification failed for $archive." >&2
  exit 1
fi

tar -xzf "$work_dir/$archive" -C "$work_dir"
binary="$work_dir/$package/svarog"
if [[ ! -f "$binary" ]]; then
  echo "The release archive does not contain $package/svarog." >&2
  exit 1
fi

mkdir -p "$install_dir"
install_temp="$(mktemp "$install_dir/.svarog.XXXXXX")"
install -m 755 "$binary" "$install_temp"

actual_version="$("$install_temp" --version)"
if [[ "$actual_version" != "svarog $version" ]]; then
  echo "The downloaded binary reported an unexpected version: $actual_version" >&2
  exit 1
fi

installed_binary="$install_dir/svarog"
mv -f "$install_temp" "$installed_binary"
install_temp=""

echo "Svarog $version installed successfully at $installed_binary"
case ":${PATH:-}:" in
  *":$install_dir:"*)
    echo "Run: svarog"
    ;;
  *)
    echo
    echo "$install_dir is not currently on PATH. Add this line to your shell configuration:"
    printf '  export PATH="%s:$PATH"\n' "$install_dir"
    echo
    echo "Start now: $installed_binary"
    ;;
esac
